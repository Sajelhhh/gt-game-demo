{
  "name": "shadow-sprout",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@playwright/test": "1.50.0",
    "@types/node": "18.19.130",
    "eslint": "9.34.0",
    "eslint-config-prettier": "10.0.1",
    "prettier": "3.4.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.40.0",
    "vitest": "2.1.8",
    "vite": "^6.4.3"
  },
  "engines": {
    "node": ">=18"
  }
}
